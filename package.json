{
  "name": "bellaso",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "scripts"],
  "scripts": {
    "dev": "bun run --filter @bellaso/web dev",
    "gateway": "bun run --filter @bellaso/gateway dev",
    "typecheck": "bun run --filter '@bellaso/*' typecheck",
    "lint": "eslint .",
    "test": "bun test",
    "build": "bun run --filter @bellaso/web build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
