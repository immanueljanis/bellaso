PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Gateway, optional. Without SPONSOR_MNEMONIC the sponsor routes answer 503.
SPONSOR_MNEMONIC=
SPONSOR_AMOUNT_UQOR=120000
SPONSOR_DAILY_CAP=50
TRANSFERS_FROM_HEIGHT=10600000
# Railway sets this to x-real-ip. Leave it empty when no proxy overwrites the header.
CLIENT_IP_HEADER=

# CLI test accounts. `bun scripts/keys.ts` fills them and prints only addresses.
RECIPIENT_MNEMONIC=
PAYER_MNEMONIC=
